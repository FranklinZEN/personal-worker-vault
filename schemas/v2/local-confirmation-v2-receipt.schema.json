{
  "$id": "vault-next://schemas/v2/local-confirmation-v2-receipt",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "algorithm": {"const": "ed25519", "type": "string"},
    "authority_id": {"const": "vault-next-local-confirmation/v2", "type": "string"},
    "bundle_id": {"pattern": "^bundle_[0-7][0-9A-HJKMNP-TV-Z]{25}$", "type": "string"},
    "confirmation_display_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "confirmed_at": {"format": "date-time", "type": "string"},
    "key_id": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "owner_receipt": {"additionalProperties": true, "type": "object"},
    "policy_proposal_digest": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "schema_version": {"const": "2.0", "type": "string"},
    "signature_base64": {"minLength": 1, "pattern": "^[A-Za-z0-9+/]+={0,2}$", "type": "string"},
    "transaction_manifest": {"additionalProperties": true, "type": "object"},
    "transaction_manifest_digest": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "transaction_id": {"pattern": "^work_transaction_[0-7][0-9A-HJKMNP-TV-Z]{25}$", "type": "string"}
  },
  "required": ["schema_version", "authority_id", "bundle_id", "algorithm", "key_id", "owner_receipt", "transaction_manifest", "transaction_manifest_digest", "transaction_id", "policy_proposal_digest", "confirmation_display_sha256", "confirmed_at", "signature_base64"],
  "title": "Vault Next signed durable local confirmation v2 receipt",
  "type": "object"
}
