{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "observation_id", "observation_version", "observation_type", "parent_event_id", "parent_manifest_digest", "catalogue_digest", "member_ref", "logical_record_id", "object_digest", "source_class", "item_class", "parser_version", "method_version", "prompt_version", "temporal_assertions", "people", "meeting_types", "strands", "inputs", "generated_artifacts", "skill_triggers", "statements", "owner_dispositions", "conflicts", "omissions", "citation_refs", "recorded_at", "candidate_only", "no_current_work", "no_promotion", "no_activation", "no_u2", "observation_digest"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "observation_id": {"type": "string", "minLength": 1},
    "observation_version": {"enum": [1, 2]},
    "observation_type": {"const": "historical_item"},
    "parent_event_id": {"type": "string", "minLength": 1},
    "parent_manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "catalogue_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "member_ref": {"type": "string", "minLength": 1},
    "logical_record_id": {"type": "string", "minLength": 1},
    "object_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_class": {"enum": ["legacy_vault", "claude_export", "codex_export"]},
    "item_class": {"type": "string", "minLength": 1},
    "parser_version": {"type": "string", "minLength": 1},
    "method_version": {"enum": ["historical_item_observer/1.0.0", "historical_item_observer/1.1.0"]},
    "prompt_version": {"enum": ["historical_item_observer/1.0.0", "historical_item_observer/1.1.0"]},
    "temporal_assertions": {"type": "array", "items": {"type": "object"}},
    "people": {"type": "array", "items": {"type": "object"}},
    "meeting_types": {"type": "array", "items": {"type": "object"}},
    "strands": {"type": "array", "items": {"type": "object"}},
    "inputs": {"type": "array", "items": {"type": "object"}},
    "generated_artifacts": {"type": "array", "items": {"type": "object"}},
    "skill_triggers": {"type": "array", "items": {"type": "object"}},
    "statements": {"type": "array", "items": {"type": "object"}},
    "owner_dispositions": {"type": "array", "items": {"type": "object"}},
    "conflicts": {"type": "array", "items": {"type": "object"}},
    "omissions": {"type": "array", "items": {"type": "object"}},
    "child_event_occurrences": {"type": "array", "items": {"type": "object"}},
    "citation_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "recorded_at": {"type": "string", "format": "date-time"},
    "candidate_only": {"const": true},
    "no_current_work": {"const": true},
    "no_promotion": {"const": true},
    "no_activation": {"const": true},
    "no_u2": {"const": true},
    "observation_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
