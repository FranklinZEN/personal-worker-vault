{
  "$id": "vault-next://schemas/v1/function-contract",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "acceptance_ids": {"items": {"pattern": "^MF-[0-9]{2}$", "type": "string"}, "minItems": 1, "type": "array", "uniqueItems": true},
    "allowed_effects": {"items": {"enum": ["read", "propose", "commit"], "type": "string"}, "minItems": 1, "type": "array", "uniqueItems": true},
    "completion_outcomes": {"items": {"enum": ["answered", "proposed", "committed", "paused", "unavailable"], "type": "string"}, "minItems": 1, "type": "array", "uniqueItems": true},
    "defaults": {"additionalProperties": true, "type": "object"},
    "dependencies": {"items": {"minLength": 1, "type": "string"}, "type": "array", "uniqueItems": true},
    "direct_entry": {"const": true, "type": "boolean"},
    "function_id": {"pattern": "^function_[a-z0-9_]+$", "type": "string"},
    "profile_package_id": {"pattern": "^profile_[a-z0-9_]+$", "type": "string"},
    "profile_version": {"pattern": "^[0-9]+[.][0-9]+[.][0-9]+$", "type": "string"},
    "readiness_capabilities": {"items": {"minLength": 1, "type": "string"}, "type": "array", "uniqueItems": true},
    "required_inputs": {"items": {"minLength": 1, "type": "string"}, "type": "array", "uniqueItems": true},
    "schema_version": {"const": "1.0", "type": "string"}
  },
  "required": ["schema_version", "function_id", "profile_package_id", "profile_version", "direct_entry", "required_inputs", "defaults", "allowed_effects", "completion_outcomes", "dependencies", "readiness_capabilities", "acceptance_ids"],
  "title": "Vault Next direct-entry function contract",
  "type": "object"
}
