{
  "$id": "vault-next://schemas/v1/local-confirmation-authority",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "algorithm": {"const": "ed25519", "type": "string"},
    "authority_id": {"const": "vault-next-local-confirmation/v1", "type": "string"},
    "key_id": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "keychain_service_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "public_key_base64": {"minLength": 1, "pattern": "^[A-Za-z0-9+/]+={0,2}$", "type": "string"},
    "schema_version": {"const": "1.0", "type": "string"}
  },
  "required": ["schema_version", "authority_id", "algorithm", "key_id", "public_key_base64", "keychain_service_sha256"],
  "title": "Vault Next local confirmation authority",
  "type": "object"
}

