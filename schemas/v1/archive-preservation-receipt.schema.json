{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "authority_id", "purpose", "admission_id", "bundle_id", "manifest_digest", "issued_at", "expires_at"],
  "properties": {
    "schema_version": {"const": "1.0"}, "receipt_id": {"type": "string", "minLength": 1},
    "authority_id": {"const": "vault-next-local-confirmation/v2"}, "purpose": {"const": "archive_preservation"},
    "admission_id": {"type": "string", "minLength": 1}, "bundle_id": {"type": "string", "minLength": 1},
    "manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "issued_at": {"type": "string", "format": "date-time"}, "expires_at": {"type": "string", "format": "date-time"}
  }
}
