{
  "$id": "vault-next://schemas/v1/chat-save-receipt",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_id": {"const": "synthetic-chat-save-authority/0.1", "type": "string"},
    "expires_at": {"format": "date-time", "type": "string"},
    "issued_at": {"format": "date-time", "type": "string"},
    "manifest_digest": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "purpose": {"const": "chat_ingress_save", "type": "string"},
    "receipt_id": {"pattern": "^receipt_[0-7][0-9A-HJKMNP-TV-Z]{25}$", "type": "string"},
    "runtime_id": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "save_id": {"pattern": "^chat_save_[0-7][0-9A-HJKMNP-TV-Z]{25}$", "type": "string"},
    "schema_version": {"const": "1.0", "type": "string"},
    "synthetic_only": {"const": true, "type": "boolean"}
  },
  "required": ["schema_version", "receipt_id", "authority_id", "purpose", "save_id", "manifest_digest", "runtime_id", "issued_at", "expires_at", "synthetic_only"],
  "title": "Synthetic exact-digest chat save receipt",
  "type": "object"
}
