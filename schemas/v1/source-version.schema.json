{
  "$id": "vault-next://schemas/v1/source-version",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "access_policy": {"const": "explicit_session_allowlist", "type": "string"},
    "byte_count": {"type": "integer"},
    "capture_manifest_sha256": {"pattern": "^[0-9a-f]{64}$", "type": ["string", "null"]},
    "capture_method": {"enum": ["synthetic_fixture", "native_local_synthetic_attachment_handoff"], "type": "string"},
    "capture_receipt_id": {"pattern": "^receipt_[0-7][0-9A-HJKMNP-TV-Z]{25}$", "type": ["string", "null"]},
    "captured_at": {"format": "date-time", "type": "string"},
    "content_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "declared_label": {"maxLength": 512, "minLength": 1, "type": "string"},
    "idempotency_key": {"minLength": 1, "type": "string"},
    "media_type": {"enum": ["text/plain", "text/markdown", "application/octet-stream"], "type": "string"},
    "object_ref": {"pattern": "^sha256/[0-9a-f]{2}/[0-9a-f]{64}$", "type": "string"},
    "prior_content_sha256": {"pattern": "^[0-9a-f]{64}$", "type": ["string", "null"]},
    "prior_source_version_id": {"pattern": "^source_version_[0-7][0-9A-HJKMNP-TV-Z]{25}$", "type": ["string", "null"]},
    "request_id": {"pattern": "^request_[0-7][0-9A-HJKMNP-TV-Z]{25}$", "type": "string"},
    "request_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "schema_version": {"const": "1.0", "type": "string"},
    "sensitivity_labels": {
      "items": {"enum": ["none", "personal", "work", "hr", "political", "legal", "formal_eval", "irreversible"], "type": "string"},
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "source_class": {"const": "synthetic_fixture", "type": "string"},
    "source_effective_at": {"format": "date-time", "type": ["string", "null"]},
    "source_family_id": {"pattern": "^source_[0-7][0-9A-HJKMNP-TV-Z]{25}$", "type": "string"},
    "source_version_id": {"pattern": "^source_version_[0-7][0-9A-HJKMNP-TV-Z]{25}$", "type": "string"}
  },
  "required": ["schema_version", "source_family_id", "source_version_id", "prior_source_version_id", "prior_content_sha256", "content_sha256", "byte_count", "media_type", "object_ref", "declared_label", "source_class", "captured_at", "source_effective_at", "sensitivity_labels", "access_policy", "capture_method", "capture_receipt_id", "capture_manifest_sha256", "request_id", "idempotency_key", "request_sha256"],
  "type": "object"
}
