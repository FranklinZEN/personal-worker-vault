{
  "$id": "vault-next://schemas/v1/evaluation-run",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "checks": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "check_id": {"minLength": 1, "type": "string"},
          "detail_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
          "passed": {"type": "boolean"}
        },
        "required": ["check_id", "passed", "detail_sha256"],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "run_id": {"minLength": 1, "type": "string"},
    "run_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "run_at": {"format": "date-time", "type": "string"},
    "schema_version": {"const": "1.0", "type": "string"},
    "suite_id": {"minLength": 1, "type": "string"},
    "suite_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "suite_version": {"minLength": 1, "type": "string"}
  },
  "required": ["schema_version", "run_id", "suite_id", "suite_version", "suite_sha256", "run_at", "checks", "run_sha256"],
  "type": "object"
}
