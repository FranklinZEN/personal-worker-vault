{
  "$id": "vault-next://schemas/v1/events/outcome-assessed",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attribution_confidence": {"enum": ["low", "medium", "high"], "type": "string"},
    "competing_explanation": {"minLength": 1, "type": "string"},
    "decision_id": {"pattern": "^decision_[0-7][0-9A-HJKMNP-TV-Z]{25}$", "type": "string"},
    "evidence_refs": {"items": {"minLength": 1, "type": "string"}, "minItems": 1, "type": "array", "uniqueItems": true},
    "explicit_confirmation": {"const": true, "type": "boolean"},
    "matured_at": {"format": "date-time", "type": "string"},
    "observed_outcome": {"minLength": 1, "type": "string"},
    "prediction_assessment": {"minLength": 1, "type": "string"},
    "process_quality": {"enum": ["strong", "adequate", "weak", "not_assessed"], "type": "string"},
    "result_quality": {"enum": ["favorable", "mixed", "unfavorable", "not_assessed"], "type": "string"}
  },
  "required": ["decision_id", "observed_outcome", "result_quality", "process_quality", "prediction_assessment", "competing_explanation", "attribution_confidence", "matured_at", "evidence_refs", "explicit_confirmation"],
  "type": "object"
}
