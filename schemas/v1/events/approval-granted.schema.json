{
  "$id": "vault-next://schemas/v1/events/approval-granted",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approval_id": {"pattern": "^approval_[0-7][0-9A-HJKMNP-TV-Z]{25}$", "type": "string"},
    "proposal_digest": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
  },
  "required": ["approval_id", "proposal_digest"],
  "type": "object"
}
