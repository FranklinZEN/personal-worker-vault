{
  "$id": "vault-next://schemas/v1/review-packet",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "case_id": {"pattern": "^case_[0-7][0-9A-HJKMNP-TV-Z]{25}$", "type": "string"},
    "created_at": {"format": "date-time", "type": "string"},
    "packet_id": {"pattern": "^review_[0-7][0-9A-HJKMNP-TV-Z]{25}$", "type": "string"},
    "policy": {
      "additionalProperties": false,
      "properties": {
        "approval_authority": {"const": false, "type": "boolean"},
        "decision_authority": {"const": false, "type": "boolean"},
        "tools_available": {"const": false, "type": "boolean"},
        "write_authority": {"const": false, "type": "boolean"}
      },
      "required": ["tools_available", "write_authority", "approval_authority", "decision_authority"],
      "type": "object"
    },
    "review_kind": {"const": "semantic_coherence", "type": "string"},
    "reviewability": {
      "additionalProperties": false,
      "properties": {
        "complete": {"type": "boolean"},
        "omissions": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "category": {"enum": ["primary_question", "target_content", "context_records", "evidence", "sensitivity"], "type": "string"},
              "reason": {"minLength": 1, "type": "string"},
              "ref": {"minLength": 1, "type": "string"}
            },
            "required": ["category", "ref", "reason"],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": ["complete", "omissions"],
      "type": "object"
    },
    "rubric_id": {"minLength": 1, "type": "string"},
    "sensitivity": {
      "additionalProperties": false,
      "properties": {
        "labels": {"items": {"minLength": 1, "type": "string"}, "type": "array", "uniqueItems": true},
        "reviewable": {"type": "boolean"},
        "withheld_source_event_ids": {"items": {"pattern": "^event_[0-7][0-9A-HJKMNP-TV-Z]{25}$", "type": "string"}, "type": "array", "uniqueItems": true}
      },
      "required": ["labels", "reviewable", "withheld_source_event_ids"],
      "type": "object"
    },
    "session_id": {"pattern": "^session_[0-7][0-9A-HJKMNP-TV-Z]{25}$", "type": "string"},
    "source_event_ids": {"items": {"pattern": "^event_[0-7][0-9A-HJKMNP-TV-Z]{25}$", "type": "string"}, "minItems": 1, "type": "array", "uniqueItems": true},
    "subject": {
      "additionalProperties": false,
      "properties": {
        "alternatives": {"items": {"type": "object"}, "type": "array"},
        "assumptions": {"items": {"type": "object"}, "type": "array"},
        "context_records": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "byte_count": {"type": "integer"},
              "event_id": {"pattern": "^event_[0-7][0-9A-HJKMNP-TV-Z]{25}$", "type": "string"},
              "event_type": {"minLength": 1, "type": "string"},
              "payload": {"additionalProperties": true, "type": "object"},
              "payload_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
            },
            "required": ["event_id", "event_type", "payload", "payload_sha256", "byte_count"],
            "type": "object"
          },
          "type": "array"
        },
        "evidence": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "byte_count": {"type": "integer"},
              "content_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
              "content_type": {"minLength": 1, "type": "string"},
              "evidence_id": {"pattern": "^evidence_sha256_[0-9a-f]{64}$", "type": "string"},
              "source_event_id": {"pattern": "^event_[0-7][0-9A-HJKMNP-TV-Z]{25}$", "type": "string"},
              "text": {"type": "string"}
            },
            "required": ["evidence_id", "source_event_id", "content_type", "content_sha256", "byte_count", "text"],
            "type": "object"
          },
          "type": "array"
        },
        "primary_question": {"minLength": 1, "type": "string"},
        "recommendations": {"items": {"type": "object"}, "type": "array"},
        "target_ref": {"minLength": 1, "type": "string"},
        "target_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "target_content": {
          "additionalProperties": false,
          "properties": {
            "byte_count": {"type": ["integer", "null"]},
            "content": {"type": ["object", "null"]},
            "content_sha256": {"pattern": "^[0-9a-f]{64}$", "type": ["string", "null"]},
            "representation": {"enum": ["event_payload", "artifact_text", "none"], "type": "string"},
            "source_event_id": {"pattern": "^event_[0-7][0-9A-HJKMNP-TV-Z]{25}$", "type": "string"},
            "status": {"enum": ["present", "omitted", "withheld"], "type": "string"},
            "text": {"type": ["string", "null"]}
          },
          "required": ["status", "representation", "source_event_id", "content_sha256", "byte_count", "content", "text"],
          "type": "object"
        },
        "target_type": {"enum": ["recommendation", "artifact_version", "checkpoint"], "type": "string"}
      },
      "required": ["primary_question", "target_type", "target_ref", "target_sha256", "recommendations", "assumptions", "alternatives"],
      "type": "object"
    },
    "schema_version": {"const": "1.0", "type": "string"},
    "source_watermark": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
  },
  "required": ["schema_version", "packet_id", "review_kind", "rubric_id", "created_at", "case_id", "session_id", "subject", "source_event_ids", "source_watermark", "sensitivity", "policy"],
  "type": "object"
}
