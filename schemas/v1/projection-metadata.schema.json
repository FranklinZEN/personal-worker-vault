{
  "$id": "vault-next://schemas/v1/projection-metadata",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "do_not_edit": {"const": true, "type": "boolean"},
    "generated_at": {"format": "date-time", "type": "string"},
    "generator_version": {"minLength": 1, "type": "string"},
    "projection_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "schema_version": {"const": "1.0", "type": "string"},
    "source_event_ids": {
      "items": {"pattern": "^event_[0-7][0-9A-HJKMNP-TV-Z]{25}$", "type": "string"},
      "type": "array",
      "uniqueItems": true
    },
    "source_watermark": {"pattern": "^(GENESIS|[0-9a-f]{64})$", "type": "string"}
  },
  "required": [
    "schema_version",
    "generator_version",
    "source_event_ids",
    "source_watermark",
    "generated_at",
    "projection_sha256",
    "do_not_edit"
  ],
  "title": "Vault Next generated projection metadata",
  "type": "object"
}
