{
  "$id": "vault-next://schemas/v1/displayed-work-view",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "as_of_date": {"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "type": "string"},
    "items": {"items": {"additionalProperties": false, "properties": {"case_id": {"pattern": "^case_[0-7][0-9A-HJKMNP-TV-Z]{25}$", "type": "string"}, "ordinal": {"type": "integer"}, "revision": {"type": "integer"}, "work_item_id": {"pattern": "^work_item_[0-7][0-9A-HJKMNP-TV-Z]{25}$", "type": "string"}}, "required": ["ordinal", "work_item_id", "case_id", "revision"], "type": "object"}, "type": "array", "uniqueItems": true},
    "scope_case_ids": {"items": {"pattern": "^case_[0-7][0-9A-HJKMNP-TV-Z]{25}$", "type": "string"}, "type": "array", "uniqueItems": true},
    "schema_version": {"const": "1.0", "type": "string"},
    "source_watermark": {"pattern": "^(GENESIS|[0-9a-f]{64})$", "type": "string"},
    "time_zone": {"minLength": 1, "type": "string"},
    "view_digest": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
  },
  "required": ["schema_version", "scope_case_ids", "as_of_date", "time_zone", "source_watermark", "items", "view_digest"],
  "title": "Vault Next displayed work-item binding",
  "type": "object"
}
