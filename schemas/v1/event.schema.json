{
  "$id": "vault-next://schemas/v1/event",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor": {
      "additionalProperties": false,
      "properties": {
        "id": {"minLength": 1, "type": "string"},
        "type": {
          "enum": ["owner", "runtime", "skill", "reviewer", "importer"],
          "type": "string"
        }
      },
      "required": ["type", "id"],
      "type": "object"
    },
    "approval_ref": {
      "pattern": "^approval_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "type": ["string", "null"]
    },
    "case_id": {
      "pattern": "^case_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "type": "string"
    },
    "causation_event_id": {
      "pattern": "^event_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "type": ["string", "null"]
    },
    "correlation_id": {"minLength": 1, "type": "string"},
    "event_id": {
      "pattern": "^event_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "type": "string"
    },
    "event_type": {
      "enum": [
        "case.created",
        "case.linked",
        "case.status_changed",
        "session.created",
        "session.status_changed",
        "question.recorded",
        "question.clarified",
        "question.reframed",
        "question.resolved",
        "triage.completed",
        "interaction.started",
        "interaction.mode_changed",
        "checkpoint.recorded",
        "owner_input.recorded",
        "routing.proposed",
        "routing.overridden",
        "skill.selected",
        "framework.selected",
        "contribution.recorded",
        "framework.stage_recorded",
        "review.finding_recorded",
        "review.requested",
        "review.completed",
        "review.waived",
        "recommendation.upheld",
        "session.started",
        "session.scope_changed",
        "session.blocked",
        "evidence.registered",
        "evidence.assessed",
        "source.version_registered",
        "source.extraction_recorded",
        "chat_ingress.save_committed",
        "direct_private_admission.recorded",
        "direct_private_admission.deactivated",
        "private_admission.recorded",
        "private_admission.deactivated",
        "knowledge.candidate_recorded",
        "knowledge.candidate_superseded",
        "knowledge.candidate_withdrawn",
        "experience.candidate_recorded",
        "experience.candidate_superseded",
        "experience.candidate_withdrawn",
        "committee.run_recorded",
        "committee.finding_recorded",
        "committee.dissent_recorded",
        "committee.challenge_recorded",
        "committee.synthesis_recorded",
        "committee.comparison_recorded",
        "public_research.citation_captured",
        "claim.recorded",
        "assumption.recorded",
        "assumption.revised",
        "alternative.recorded",
        "alternative.disposition_changed",
        "disagreement.recorded",
        "disagreement.resolved",
        "recommendation.issued",
        "recommendation.revised",
        "recommendation.withdrawn",
        "artifact.version_created",
        "artifact.feedback_recorded",
        "artifact.accepted",
        "artifact.withdrawn",
        "work_item.recorded",
        "work_item.status_changed",
        "owner_decision.recorded",
        "owner_decision.revised",
        "owner_decision.superseded",
        "outcome.assessed",
        "approval.granted",
        "approval.denied",
        "action.proposed",
        "session.closed",
        "event.correction_recorded"
      ],
      "type": "string"
    },
    "integrity": {
      "additionalProperties": false,
      "properties": {
        "event_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "payload_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "previous_event_sha256": {
          "pattern": "^(GENESIS|[0-9a-f]{64})$",
          "type": "string"
        }
      },
      "required": ["payload_sha256", "previous_event_sha256", "event_sha256"],
      "type": "object"
    },
    "occurred_at": {"format": "date-time", "type": "string"},
    "payload": {"additionalProperties": true, "type": "object"},
    "provenance": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "ref": {"minLength": 1, "type": "string"},
          "relation": {
            "enum": [
              "quotes",
              "summarizes",
              "supports",
              "challenges",
              "derives_from",
              "responds_to",
              "corrects",
              "supersedes",
              "caused_by"
            ],
            "type": "string"
          }
        },
        "required": ["ref", "relation"],
        "type": "object"
      },
      "type": "array"
    },
    "recorded_at": {"format": "date-time", "type": "string"},
    "schema_version": {"const": "1.0", "type": "string"},
    "sensitivity": {
      "enum": ["none", "personal", "work", "hr", "political", "legal", "formal_eval", "irreversible"],
      "type": "string"
    },
    "session_id": {
      "pattern": "^session_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "type": ["string", "null"]
    },
    "subject_refs": {"items": {"minLength": 1, "type": "string"}, "type": "array"}
  },
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "occurred_at",
    "recorded_at",
    "actor",
    "case_id",
    "session_id",
    "subject_refs",
    "correlation_id",
    "causation_event_id",
    "provenance",
    "sensitivity",
    "approval_ref",
    "payload",
    "integrity"
  ],
  "title": "Vault Next semantic event envelope",
  "type": "object"
}
