{
  "$id": "vault-next://schemas/v1/local-confirmation-receipt",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "algorithm": {"const": "ed25519", "type": "string"},
    "authority_id": {"const": "vault-next-local-confirmation/v1", "type": "string"},
    "confirmation_display_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "confirmed_at": {"format": "date-time", "type": "string"},
    "key_id": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "owner_receipt": {"additionalProperties": true, "type": "object"},
    "schema_version": {"const": "1.0", "type": "string"},
    "signature_base64": {"minLength": 1, "pattern": "^[A-Za-z0-9+/]+={0,2}$", "type": "string"},
    "work_change_proposal": {"additionalProperties": true, "type": "object"},
    "work_change_proposal_digest": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
  },
  "required": ["schema_version", "authority_id", "algorithm", "key_id", "owner_receipt", "work_change_proposal", "work_change_proposal_digest", "confirmation_display_sha256", "confirmed_at", "signature_base64"],
  "title": "Vault Next signed local confirmation receipt",
  "type": "object"
}

