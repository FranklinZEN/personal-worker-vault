{
  "$id": "vault-next://schemas/v1/s3-source-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "citation": {
      "additionalProperties": false,
      "properties": {
        "anchor": {"minLength": 1, "type": "string"},
        "chunk_text_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "extractor_version": {"const": "utf8-structure-v1", "type": "string"},
        "registration_event_id": {"pattern": "^event_[0-7][0-9A-HJKMNP-TV-Z]{25}$", "type": "string"},
        "source_object_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "source_version_id": {"pattern": "^source_version_[0-7][0-9A-HJKMNP-TV-Z]{25}$", "type": "string"}
      },
      "required": ["source_version_id", "registration_event_id", "source_object_sha256", "extractor_version", "anchor", "chunk_text_sha256"],
      "type": ["object", "null"]
    },
    "operation": {"enum": ["register", "extract", "rebuild", "retrieve", "cite"], "type": "string"},
    "query": {"maxLength": 512, "minLength": 1, "type": ["string", "null"]},
    "registration": {
      "additionalProperties": false,
      "properties": {
        "byte_count": {"type": "integer"},
        "capture_manifest_sha256": {"pattern": "^[0-9a-f]{64}$", "type": ["string", "null"]},
        "capture_method": {"enum": ["synthetic_fixture", "native_local_synthetic_attachment_handoff"], "type": ["string", "null"]},
        "capture_receipt_id": {"pattern": "^receipt_[0-7][0-9A-HJKMNP-TV-Z]{25}$", "type": ["string", "null"]},
        "content_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "declared_label": {"maxLength": 512, "minLength": 1, "type": "string"},
        "media_type": {"enum": ["text/plain", "text/markdown", "application/octet-stream"], "type": "string"},
        "prior_content_sha256": {"pattern": "^[0-9a-f]{64}$", "type": ["string", "null"]},
        "prior_source_version_id": {"pattern": "^source_version_[0-7][0-9A-HJKMNP-TV-Z]{25}$", "type": ["string", "null"]},
        "sensitivity_labels": {"items": {"enum": ["none", "personal", "work", "hr", "political", "legal", "formal_eval", "irreversible"], "type": "string"}, "minItems": 1, "type": "array", "uniqueItems": true},
        "source_effective_at": {"format": "date-time", "type": ["string", "null"]},
        "source_family_id": {"pattern": "^source_[0-7][0-9A-HJKMNP-TV-Z]{25}$", "type": "string"}
      },
      "required": ["source_family_id", "prior_source_version_id", "prior_content_sha256", "content_sha256", "byte_count", "media_type", "declared_label", "source_effective_at", "sensitivity_labels"],
      "type": ["object", "null"]
    },
    "request": {"type": "object"},
    "session_id": {"pattern": "^session_[0-7][0-9A-HJKMNP-TV-Z]{25}$", "type": "string"},
    "source_bindings": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "content_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
          "registration_event_id": {"pattern": "^event_[0-7][0-9A-HJKMNP-TV-Z]{25}$", "type": "string"},
          "source_version_id": {"pattern": "^source_version_[0-7][0-9A-HJKMNP-TV-Z]{25}$", "type": "string"}
        },
        "required": ["registration_event_id", "source_version_id", "content_sha256"],
        "type": "object"
      },
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": ["request", "operation", "session_id", "registration", "source_bindings", "query", "citation"],
  "type": "object"
}
