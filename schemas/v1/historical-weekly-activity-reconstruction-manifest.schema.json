{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "component", "purpose", "authority_id", "admission_id", "bundle_id", "family", "week_start", "week_end", "parent_bindings", "parent_set_digest", "catalogue_set_digest", "selected_sources", "logical_record_digests", "item_observation_digests", "conversation_observation_digests", "weekly_wave_digest", "cross_wave_reconciliation_digest", "primary_artifact_digest", "support_view_digests", "disclosure", "candidate_only", "operations", "expires_at", "manifest_digest"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "component": {"const": "vault-next-historical-weekly-activity-reconstruction/1.0.0"},
    "purpose": {"const": "historical_weekly_activity_reconstruction"},
    "authority_id": {"const": "vault-next-local-confirmation/v2"},
    "admission_id": {"type": "string", "minLength": 1},
    "bundle_id": {"type": "string", "minLength": 1},
    "family": {"const": "meeting_workstream_history"},
    "week_start": {"type": "string", "format": "date-time"},
    "week_end": {"type": "string", "format": "date-time"},
    "parent_bindings": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "object"}},
    "parent_set_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "catalogue_set_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "selected_sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "object"}},
    "logical_record_digests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "item_observation_digests": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "conversation_observation_digests": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "weekly_wave_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cross_wave_reconciliation_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "primary_artifact_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "support_view_digests": {"type": "object"},
    "disclosure": {"const": "hybrid_visible_hosted_exact_packs_local_private_storage"},
    "candidate_only": {"const": true},
    "operations": {"type": "array", "minItems": 3, "items": {"type": "string"}},
    "expires_at": {"type": "string", "format": "date-time"},
    "manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
