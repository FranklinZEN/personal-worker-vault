{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "authority_id", "authority_bundle_id", "purpose", "manifest", "manifest_digest", "receipt"],
  "properties": {
    "schema_version": {"const": "1.0"}, "authority_id": {"const": "vault-next-local-confirmation/v2"},
    "authority_bundle_id": {"type": "string"}, "purpose": {"const": "historical_activity_reconstruction"},
    "manifest": {"type": "object"}, "manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "receipt": {"type": "object"}
  }
}
